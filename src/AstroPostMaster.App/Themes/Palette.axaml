<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Design tokens (spec §5). The accent is reserved for: selected slide, active crop frame, primary Export button. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="BgBrush" Color="#161616" />
      <SolidColorBrush x:Key="PanelBrush" Color="#1E1E1E" />
      <SolidColorBrush x:Key="InputBrush" Color="#2A2A2A" />
      <SolidColorBrush x:Key="LineBrush" Color="#333333" />
      <SolidColorBrush x:Key="TextBrush" Color="#E6E6E6" />
      <SolidColorBrush x:Key="MutedBrush" Color="#9A9A9A" />
      <SolidColorBrush x:Key="AccentBrush" Color="#C8963E" />
      <SolidColorBrush x:Key="OnAccentBrush" Color="#161616" />
      <SolidColorBrush x:Key="ErrorBrush" Color="#C0584F" />
      <SolidColorBrush x:Key="CanvasBrush" Color="#111111" />
      <SolidColorBrush x:Key="FrameBrush" Color="#9A9A9A" />
      <SolidColorBrush x:Key="DimBrush" Color="#73000000" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="BgBrush" Color="#F4F3F1" />
      <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="InputBrush" Color="#E6E4E0" />
      <SolidColorBrush x:Key="LineBrush" Color="#D0CDC8" />
      <SolidColorBrush x:Key="TextBrush" Color="#1E1E1E" />
      <SolidColorBrush x:Key="MutedBrush" Color="#66625C" />
      <SolidColorBrush x:Key="AccentBrush" Color="#A8792A" />
      <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ErrorBrush" Color="#A8443C" />
      <SolidColorBrush x:Key="CanvasBrush" Color="#2B2A28" />
      <SolidColorBrush x:Key="FrameBrush" Color="#C9C5BE" />
      <SolidColorBrush x:Key="DimBrush" Color="#73000000" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <CornerRadius x:Key="Radius">4</CornerRadius>
  <FontFamily x:Key="MonoFont">Cascadia Mono, JetBrains Mono, DejaVu Sans Mono, Menlo, Consolas, monospace</FontFamily>
</ResourceDictionary>
