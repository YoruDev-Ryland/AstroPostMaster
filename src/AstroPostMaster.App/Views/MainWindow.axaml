<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AstroPostMaster.App.ViewModels"
        xmlns:views="using:AstroPostMaster.App.Views"
        x:Class="AstroPostMaster.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="AstroPostMaster" Width="1440" Height="900" MinWidth="1080" MinHeight="660"
        DragDrop.AllowDrop="True">
  <Grid RowDefinitions="*,Auto">
    <Grid ColumnDefinitions="Auto,*,360">

      <!-- Posts -->
      <Border x:Name="Sidebar" Classes="panel" BorderThickness="0,0,1,0" Width="232">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="16,10,8,6">
            <TextBlock Classes="section" Text="POSTS" Margin="0" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="icon" Command="{Binding NewPostCommand}" ToolTip.Tip="New post (Ctrl+N)">
              <Path Classes="icon" Data="{StaticResource IconPlus}" />
            </Button>
          </Grid>
          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="8,6">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button Classes="icon" Command="{Binding DuplicatePostCommand}" ToolTip.Tip="Duplicate post">
                <Path Classes="icon" Data="{StaticResource IconDuplicate}" />
              </Button>
              <Button Classes="icon" Click="OnDeletePost" ToolTip.Tip="Delete post">
                <Path Classes="icon" Data="{StaticResource IconTrash}" />
              </Button>
              <Button Classes="icon" Click="OnOpenSettings" ToolTip.Tip="Settings (Ctrl+,)">
                <Path Classes="icon" Data="{StaticResource IconSettings}" />
              </Button>
            </StackPanel>
          </Border>
          <ListBox ItemsSource="{Binding Posts}" SelectedItem="{Binding SelectedPost}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PostListItemViewModel">
                <StackPanel Margin="2,3">
                  <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="11" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Editor -->
      <Grid Grid.Column="1" RowDefinitions="48,*,Auto">
        <Border Classes="panel" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="8,0,12,0">
            <Button Classes="icon" Click="OnToggleSidebar" ToolTip.Tip="Show or hide posts" VerticalAlignment="Center">
              <Path Classes="icon" Data="{StaticResource IconSidebar}" />
            </Button>
            <TextBox Grid.Column="1" Text="{Binding Editor.Title, FallbackValue=''}" IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNotNull}}"
                     FontSize="15" FontWeight="SemiBold" BorderThickness="0" Background="Transparent" Margin="4,0,12,0"
                     VerticalAlignment="Center" MaxWidth="460" HorizontalAlignment="Left" PlaceholderText="Post title" />
            <ComboBox Grid.Column="2" x:Name="AspectBox" VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="150"
                      IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNotNull}}"
                      ItemsSource="{x:Static vm:EditorViewModel.AspectOptions}" SelectedIndex="{Binding Editor.AspectIndex, FallbackValue=0}"
                      ToolTip.Tip="Slide shape for the whole post">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:AspectOption">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding Label}" FontFamily="{StaticResource MonoFont}" MinWidth="44" />
                    <TextBlock Text="{Binding Group}" Classes="muted" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="3" Click="OnOpenImage" VerticalAlignment="Center" ToolTip.Tip="Open an image (Ctrl+O)">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Classes="icon" Data="{StaticResource IconImage}" />
                <TextBlock Text="Open image" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>
        <views:CropCanvas x:Name="Canvas" Grid.Row="1" Editor="{Binding Editor}" />
        <views:Filmstrip Grid.Row="2" DataContext="{Binding Editor}" x:DataType="vm:EditorViewModel" IsVisible="{Binding HasSource, FallbackValue=False}" />
      </Grid>

      <!-- Inspector -->
      <Border Grid.Column="2" Classes="panel" BorderThickness="1,0,0,0">
        <DockPanel>
          <Border DockPanel.Dock="Top" Classes="card" Margin="16,16,16,0" IsVisible="{Binding NeedsProfileSetup}">
            <StackPanel Spacing="8">
              <TextBlock Text="Add your site, rig and software" FontWeight="SemiBold" TextWrapping="Wrap" />
              <Button Content="Set up profiles…" Click="OnOpenSettings" />
            </StackPanel>
          </Border>
          <views:InspectorView x:Name="Inspector" DataContext="{Binding Editor}"
                               IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </DockPanel>
      </Border>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="1" Classes="panel" BorderThickness="0,1,0,0" Height="44">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="16,0,10,0">
        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center"
                    IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Classes="stat" Text="{Binding Editor.AspectLabel, FallbackValue=''}" />
          <TextBlock Classes="stat" Classes.over="{Binding Editor.TooManySlides, FallbackValue=False}"
                     Text="{Binding Editor.SlideCount, StringFormat='{}{0} slides', FallbackValue=''}" />
          <TextBlock Classes="stat" Classes.over="{Binding Editor.TooLong, FallbackValue=False}"
                     Text="{Binding Editor.CharacterCount, StringFormat='{}{0:N0} / 2,200', FallbackValue=''}" ToolTip.Tip="Caption characters" />
          <TextBlock Classes="stat" Classes.over="{Binding Editor.TooManyHashtags, FallbackValue=False}"
                     Text="{Binding Editor.HashtagCount, StringFormat='#{0} / 30', FallbackValue=''}" ToolTip.Tip="Hashtags" />
        </StackPanel>
        <TextBlock Grid.Column="1" Classes="muted" Text="{Binding StatusLine}" Margin="20,0" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" FontSize="12" />
        <Button Grid.Column="2" Classes="link" Click="OnSupport" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"
                Content="Support AstroPostMaster" ToolTip.Tip="ko-fi.com/rkremeier" />
        <ComboBox Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,0" MinWidth="150"
                  IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNotNull}}"
                  ItemsSource="{x:Static vm:EditorViewModel.ExportSizeOptions}" SelectedIndex="{Binding Editor.ExportSizeIndex, FallbackValue=0}"
                  ToolTip.Tip="Size of the exported slides for this post">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ExportSizeOption">
              <StackPanel Spacing="1">
                <TextBlock Text="{Binding Label}" />
                <TextBlock Text="{Binding Hint}" Classes="muted" FontSize="11" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
          <ComboBox.SelectionBoxItemTemplate>
            <DataTemplate x:DataType="vm:ExportSizeOption">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.SelectionBoxItemTemplate>
        </ComboBox>
        <Button Grid.Column="4" Classes="primary" VerticalAlignment="Center" Padding="14,6"
                IsEnabled="{Binding Editor.HasSource, FallbackValue=False}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Export" VerticalAlignment="Center" />
            <Path Classes="icon" Data="{StaticResource IconChevronRight}" Width="12" Height="12" />
          </StackPanel>
          <Button.Flyout>
            <MenuFlyout Placement="TopEdgeAlignedRight">
              <MenuItem Header="Send to phone…" InputGesture="Ctrl+E" Click="OnSendToPhone" />
              <MenuItem Header="Export to folder…" Click="OnExportToFolder" />
              <MenuItem Header="Copy caption" Click="OnCopyCaption" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </Grid>
    </Border>
  </Grid>
</Window>
