<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AstroPostMaster.App.ViewModels"
        xmlns:views="using:AstroPostMaster.App.Views"
        x:Class="AstroPostMaster.App.Views.PhoneExportWindow"
        x:DataType="vm:PhoneExportViewModel"
        Title="Send to phone" Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="Border.card.blocked">
      <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </Window.Styles>
  <StackPanel Margin="24" Spacing="14">
    <StackPanel Spacing="2">
      <TextBlock Classes="title" Text="Send to phone" />
      <TextBlock Classes="muted" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
    </StackPanel>

    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" IsVisible="{Binding IsExporting}" Height="4" />

    <Border Background="White" Padding="14" CornerRadius="4" HorizontalAlignment="Center"
            IsVisible="{Binding QrPng, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Image Width="252" Height="252" RenderOptions.BitmapInterpolationMode="None"
             Source="{Binding QrPng, Converter={x:Static views:PngBytesConverter.Instance}}" />
    </Border>

    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Classes.error="{Binding HasError}" />

    <Border Classes="card" Classes.blocked="{Binding FirewallBlocked}" IsVisible="{Binding ShowFirewallCard}">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding FirewallMessage}" FontWeight="SemiBold" TextWrapping="Wrap"
                   IsVisible="{Binding FirewallMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding CanFixFirewall}">
          <Button Content="Allow on my home network" Click="OnFixFirewall" IsEnabled="{Binding !IsFixingFirewall}" />
          <Button Classes="link" Content="Copy command" Click="OnCopyFirewallCommand" />
        </StackPanel>
        <TextBlock Text="{Binding FirewallNote}" FontSize="12" TextWrapping="Wrap"
                   IsVisible="{Binding FirewallNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
    </Border>

    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Url, Converter={x:Static ObjectConverters.IsNotNull}}">
      <SelectableTextBlock Classes="muted" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center"
                           Text="{Binding Url, StringFormat='{}{0}'}" TextWrapping="Wrap" />
      <Button Grid.Column="1" Classes="link" Content="Copy link" Click="OnCopyLink" Margin="8,0,0,0" />
    </Grid>

    <StackPanel Spacing="4" IsVisible="{Binding HasMultipleAddresses}">
      <TextBlock Classes="label" Text="Network address" Margin="0" />
      <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Addresses}" SelectedItem="{Binding SelectedAddress}" />
    </StackPanel>

    <Border Classes="card" IsVisible="{Binding ShowConnectionHelp}">
      <StackPanel Spacing="4">
        <TextBlock Text="Phone can't connect?" FontWeight="SemiBold" />
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="Use the same Wi-Fi (not a guest network), and accept the certificate warning on the phone." />
      </StackPanel>
    </Border>

    <Button Content="Done" HorizontalAlignment="Right" Click="OnDone" />
  </StackPanel>
</Window>
